rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 每個人只能碰自己的資料，其他一律拒絕。
    // 匿名登入也算已登入，uid 一樣受這條保護。
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
